# Vercel の「Settings → Environment Variables」に同じ名前で登録します。
# ローカルでは何も設定しなくても動きます（SQLite とローカル認証を使用）。

# セッションの署名に使う長いランダム文字列。作り方: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase → Connect → Transaction pooler の接続文字列（ポート 6543）
DATABASE_URL=postgresql://postgres.xxxxxxxx:パスワード@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# プッシュ通知の鍵。作り方: python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:あなたのメールアドレス

# 毎朝の通知（Vercel Cron）を守る合言葉。SECRET_KEY と同じ作り方で別の値を入れる
CRON_SECRET=
